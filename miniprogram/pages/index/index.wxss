.shell{display:flex;height:100vh;color:#302443;background:#f8f6fc}.left,.right{width:50%;min-width:0}.left{display:flex;flex-direction:column}.search{padding:28rpx;background:#fff}.heading{font-size:38rpx;font-weight:700}.note,.meta{font-size:24rpx;color:#736b80;line-height:1.7}.input{box-sizing:border-box;width:100%;height:88rpx;padding:20rpx;margin:24rpx 0;border:1px solid #ded5eb;border-radius:16rpx}.actions{display:flex;margin-bottom:20rpx}.actions button{flex:1;margin:0 8rpx;font-size:26rpx}.primary{background:#7546c8;color:white}.results{flex:1;min-height:0;box-sizing:border-box;padding:24rpx}.card{padding:24rpx;margin-bottom:20rpx;background:white;border:1px solid #e5ddef;border-radius:18rpx}.name{font-size:30rpx;font-weight:600;margin-bottom:12rpx}.empty{padding:28rpx;color:#736b80;line-height:1.8}.right{padding:24rpx;box-sizing:border-box}.live-map{width:100%;height:60vh;margin-bottom:20rpx}.mobile-tabs{display:none}.card button{margin-top:20rpx}@media(max-width:720px){.shell{display:block;height:auto}.left,.right{width:100%}.results{height:52vh}.mobile-tabs{display:flex;padding:16rpx}.mobile-tabs button{flex:1;font-size:26rpx;margin:0 8rpx}.mobile-hidden{display:none}.live-map{height:48vh}}

.city-row{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.city{font-size:30rpx;color:#7546c8;font-weight:600}.city-row button{margin:0;font-size:22rpx}.categories{display:flex;gap:12rpx;margin-top:20rpx}.categories button{flex:1;font-size:26rpx;padding:0 8rpx}.distance{color:#7546c8;font-weight:600;font-size:26rpx;margin-bottom:8rpx}.aed-note{font-size:24rpx;background:#fff5e8;color:#855413;padding:16rpx;border-radius:12rpx;line-height:1.6}

.contact-footer{text-align:center;padding:28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));background:#f8f6fc;border-top:1px solid #e5ddef}.contact-title{font-size:24rpx;color:#736b80;margin-bottom:8rpx}.contact-button{display:inline-block;background:transparent;color:#7546c8;font-size:26rpx;padding:0 20rpx;margin:0}.contact-button::after{border:0}

.search-modes{display:flex;gap:12rpx;margin-top:20rpx}.search-modes button{flex:1;background:transparent;color:#736b80;font-size:24rpx}.search-modes .mode-active{color:#7546c8;background:#f1eafa}.metro-fields{margin-top:16rpx}.metro-fields .input{margin:12rpx 0}
